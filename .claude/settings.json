{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__mcp-adapter-execute-ability",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/bin/ability-gate\" claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
