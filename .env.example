# wordpress-claude-mcp — local development environment.
#
# Copy to .env and adjust. .env is git-ignored and never leaves this machine.
#   cp .env.example .env
#
# ./bin/setup replaces every CHANGE_ME value with a freshly generated random
# secret and writes it back to .env, so copying this file unedited is fine.

# ---------------------------------------------------------------------------
# Docker Compose project
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=wordpress-claude-mcp

# ---------------------------------------------------------------------------
# Host ports (bound to 127.0.0.1 only — never exposed on the network)
# ---------------------------------------------------------------------------
WP_PORT=8080
DB_PORT=3307

# ---------------------------------------------------------------------------
# Pinned image and dependency versions.
# See docs/development.md ("Updating dependencies") before changing these.
# ---------------------------------------------------------------------------
WORDPRESS_IMAGE=wordpress:7.1.0-php8.3-apache
MARIADB_IMAGE=mariadb:11.8.9

# WP-CLI phar (pinned, checksum-verified in docker/wordpress/Dockerfile)
WP_CLI_VERSION=2.12.0
# wp-cli/ability-command — provides `wp ability`, the diagnostic path into the
# Abilities API that does not go through MCP.
WP_CLI_ABILITY_COMMAND_VERSION=1.0.2

# WordPress plugins, installed from their pinned upstream GitHub release ZIPs.
MCP_ADAPTER_VERSION=0.6.1
MS_WP_ABILITIES_VERSION=1.12.0

# Theme installed and activated by ./bin/setup.
WP_THEME=twentytwentyfive

# ---------------------------------------------------------------------------
# WordPress site
# ---------------------------------------------------------------------------
WP_SITE_TITLE=WordPress Claude MCP
WP_ADMIN_USER=admin
WP_ADMIN_EMAIL=admin@wordpress-claude-mcp.test
WP_ADMIN_PASSWORD=CHANGE_ME

# Label of the WordPress Application Password that Claude Code authenticates
# with. The password itself is generated by WordPress and stored in
# .secrets/application-password (git-ignored) — never in this file.
MCP_APP_PASSWORD_NAME=claude-code-mcp

# Name Claude Code registers the MCP server under (`claude mcp list`).
MCP_SERVER_NAME=wordpress

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
