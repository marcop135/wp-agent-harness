# Line endings. Every script in this repository runs inside a Linux container
# or under Bash; a CRLF checkout breaks the shebang and `docker build`.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
*.phar binary

# Keep development scaffolding out of a `git archive` tarball.
/.github/       export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/tests/         export-ignore
/examples/      export-ignore
