#!/usr/bin/env bash
#
# connect — register the local WordPress MCP server with Claude Code.
#
#   ./bin/connect            add (or replace) the registration for this project
#   ./bin/connect --remove   remove it
#   ./bin/connect --print    print the endpoint and header without touching config
#
# The Application Password is written into Claude Code's own configuration
# (~/.claude.json, local scope — this project only), never into a file in this
# repository. See docs/claude-code.md.

source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

require_env

action='add'
case "${1:-}" in
    '')                 ;;
    --remove|--disconnect) action='remove' ;;
    --print)            action='print' ;;
    -h|--help)          sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)                  die "Unknown option: $1" ;;
esac

have claude || die 'claude is not on PATH. Install Claude Code, then re-run ./bin/connect.'

server_name="$(env_get MCP_SERVER_NAME wordpress)"
endpoint="$(mcp_endpoint)"

if [[ "$action" == 'remove' ]]; then
    step "Removing MCP server '$server_name'"
    ( cd "$REPO_ROOT" && claude mcp remove "$server_name" ) \
        || die "Claude Code has no MCP server called '$server_name' for this project."
    ok 'Removed'
    exit 0
fi

creds="$(mcp_basic_auth 2>/dev/null)" \
    || die "No Application Password found in ${APP_PASSWORD_FILE#"$REPO_ROOT/"}.
    Run ./bin/setup first."

basic="$(printf '%s' "$creds" | base64 | tr -d '\r\n')"

if [[ "$action" == 'print' ]]; then
    printf 'transport   http\n'
    printf 'name        %s\n' "$server_name"
    printf 'url         %s\n' "$endpoint"
    printf 'header      Authorization: Basic %s\n' "$basic"
    exit 0
fi

require_docker
container_running wordpress \
    || die 'The wordpress container is not running. Run ./bin/start, then ./bin/connect.'

step "Registering MCP server '$server_name' with Claude Code"
info "transport  http"
info "url        $endpoint"
info "auth       Authorization: Basic <application password>"

# Replace rather than append, so re-running after ./bin/reset picks up the new
# Application Password instead of leaving a stale one behind.
( cd "$REPO_ROOT" && claude mcp remove "$server_name" >/dev/null 2>&1 ) || true

(
    cd "$REPO_ROOT" && claude mcp add \
        --transport http \
        --scope local \
        "$server_name" "$endpoint" \
        --header "Authorization: Basic $basic"
) || die 'claude mcp add failed. See docs/troubleshooting.md.'

( cd "$REPO_ROOT" && claude mcp get "$server_name" >/dev/null 2>&1 ) \
    || die "Claude Code did not persist the '$server_name' server."

ok "Registered for $REPO_ROOT (local scope — this project only)"

printf '\n%sClaude Code is connected.%s\n\n' "$C_GREEN$C_BOLD" "$C_RESET"
printf '  Start Claude Code from this directory:\n'
printf '      cd %s && claude\n\n' "$REPO_ROOT"
printf '  Then try:\n'
printf '      "Inspect the local WordPress site: version, active theme,\n'
printf '       active plugins, site title and available post types."\n\n'
printf '  More prompts: examples/README.md\n\n'
