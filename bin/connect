#!/usr/bin/env bash
#
# connect — register the local WordPress MCP server with an agent client.
#
#   ./bin/connect            add (or replace) the Claude Code registration
#   ./bin/connect --remove   remove the Claude Code registration
#   ./bin/connect --print    print endpoint, header, and env export (no Claude required)
#   --role admin|publisher|reader
#                            WordPress login to connect as (default admin)
#
# Claude Code: writes into ~/.claude.json (local scope), never into this repo.
# Codex: project config is .codex/config.toml; export WORDPRESS_MCP_BASIC_AUTH
# from --print. Cursor and other MCP clients use the same URL and header.
# See docs/claude-code.md and docs/codex.md.

source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

require_env

action='add'
role='admin'
while [[ $# -gt 0 ]]; do
    case "$1" in
        --remove|--disconnect) action='remove' ;;
        --print)            action='print' ;;
        --role)             [[ $# -ge 2 ]] || die '--role needs a value: admin, publisher or reader.'
                            role="$2"; shift ;;
        --role=*)           role="${1#--role=}" ;;
        -h|--help)          sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)                  die "Unknown option: $1" ;;
    esac
    shift
done
is_mcp_role "$role" || die "Unknown role '$role'. Use admin, publisher or reader."

server_name="$(env_get MCP_SERVER_NAME wordpress)"
endpoint="$(mcp_endpoint)"

if [[ "$action" == 'remove' ]]; then
    have claude || die 'claude is not on PATH. Install Claude Code, then re-run ./bin/connect --remove.'
    step "Removing MCP server '$server_name'"
    ( cd "$REPO_ROOT" && claude mcp remove --scope local "$server_name" ) \
        || die "Claude Code has no MCP server called '$server_name' for this project."
    rm -f "$MCP_ROLE_FILE"
    ok 'Removed'
    exit 0
fi

login="$(role_login "$role")"
password_file="$(app_password_file "$role")"
creds="$(mcp_basic_auth "$role" 2>/dev/null)" \
    || die "No Application Password for $role ($login) in ${password_file#"$REPO_ROOT/"}.
    Run ./bin/setup first."

basic="$(printf '%s' "$creds" | base64 | tr -d '\r\n')"
auth_header="Basic $basic"

# Record the role so bin/ability-gate names the login a write runs as.
record_role() {
    ( umask 077 && mkdir -p "$SECRETS_DIR" && printf '%s\n' "$role" > "$MCP_ROLE_FILE" )
}

if [[ "$action" == 'print' ]]; then
    record_role
    printf '%sWarning:%s stdout includes a live Basic auth header. Do not paste it into\n' "$C_YELLOW" "$C_RESET" >&2
    printf '    tickets or logs; clear it from shell history on shared machines.\n\n' >&2
    printf 'transport   http\n'
    printf 'name        %s\n' "$server_name"
    printf 'role        %s (WordPress login %s)\n' "$role" "$login"
    printf 'url         %s\n' "$endpoint"
    printf 'header      Authorization: %s\n' "$auth_header"
    printf '\n'
    printf '# Export for Codex (.codex/config.toml), Cursor, or any MCP HTTP client:\n'
    printf "export WORDPRESS_MCP_BASIC_AUTH='%s'\n" "$auth_header"
    printf '\n'
    printf '# Claude Code one-shot registration (requires claude on PATH):\n'
    printf '#   ./bin/connect\n'
    printf '# Codex: trust this project, export the variable above, then run codex here.\n'
    printf '# Detail: docs/codex.md · docs/claude-code.md\n'
    exit 0
fi

have claude || die 'claude is not on PATH. Install Claude Code, then re-run ./bin/connect.'

require_docker
container_running wordpress \
    || die 'The wordpress container is not running. Run ./bin/start, then ./bin/connect.'

step "Registering MCP server '$server_name' with Claude Code"
info "transport  http"
info "url        $endpoint"
info "role       $role (WordPress login $login)"
info "auth       Authorization: Basic <application password>"

# Replace rather than append, so re-running after ./bin/reset picks up the new
# Application Password instead of leaving a stale one behind.
( cd "$REPO_ROOT" && claude mcp remove --scope local "$server_name" >/dev/null 2>&1 ) || true

(
    cd "$REPO_ROOT" && claude mcp add \
        --transport http \
        --scope local \
        "$server_name" "$endpoint" \
        --header "Authorization: $auth_header"
) || die 'claude mcp add failed. See docs/troubleshooting.md.'

( cd "$REPO_ROOT" && claude mcp get "$server_name" >/dev/null 2>&1 ) \
    || die "Claude Code did not persist the '$server_name' server."
record_role

ok "Registered for $REPO_ROOT (local scope, this project only) as $login"

printf '\n%sClaude Code is connected.%s\n\n' "$C_GREEN$C_BOLD" "$C_RESET"
printf '  Start Claude Code from this directory:\n'
printf '      cd %s && claude\n\n' "$REPO_ROOT"
printf '  Codex / Cursor: ./bin/connect --print  then docs/codex.md\n\n'
printf '  Then try:\n'
printf '      "Inspect the local WordPress site: version, active theme,\n'
printf '       active plugins, site title and available post types."\n\n'
printf '  More prompts: examples/README.md\n\n'
