#!/usr/bin/env bash
#
# ability-gate: approval gate for WordPress writes over MCP.
#
# A pre-tool hook for Claude Code and Cursor. It reads the hook payload on
# stdin, and when the tool is mcp-adapter-execute-ability it classifies the
# ability: reads pass, everything else makes the client ask you first, or is
# denied outright when connected with --role reader. Unknown abilities and
# unreadable payloads count as writes.
#
#   .claude/settings.json   PreToolUse         -> ./bin/ability-gate claude
#   .cursor/hooks.json      beforeMCPExecution -> ./bin/ability-gate cursor
#
#   ./bin/ability-gate classify <namespace>/trash-post    prints read | write
#
# The read set mirrors MS WP Abilities' own policy table (write: false), which
# tests/integration.sh checks against the live plugin.

set -euo pipefail

classify() {
    case "$1" in
        miriamschwab/get-posts|miriamschwab/get-pages|miriamschwab/get-post-meta|\
        miriamschwab/get-post-types|miriamschwab/get-categories|miriamschwab/get-tags|\
        miriamschwab/get-media|miriamschwab/get-site-settings|miriamschwab/get-users|\
        miriamschwab/get-menus|miriamschwab/get-plugins|miriamschwab/get-themes|\
        miriamschwab/get-available-updates|miriamschwab/rest-get|\
        miriamschwab/preview-post-update|core/get-site-info|core/get-user-info|\
        core/get-environment-info) printf 'read' ;;
        *) printf 'write' ;;
    esac
}

# Accept one hook object only. Invalid input must reach the approval path.
hook_field() {
    jq -ers "select(length == 1) | .[0] | select(type == \"object\") | $1 | select(type == \"string\" and length > 0) | select(explode | all(. >= 32 and . != 127))" \
        <<<"$payload" 2>/dev/null | tr -d '\r' || true
}

# The agent connects as the role ./bin/connect --role recorded in
# .secrets/mcp-role: admin (WP_ADMIN_USER), publisher (WP_PUBLISHER_USER) or
# reader (WP_READER_USER). No recorded role means admin.
readonly ENV_FILE="${ABILITY_GATE_ENV_FILE:-$(dirname -- "${BASH_SOURCE[0]}")/../.env}"
readonly ROLE_FILE="${ABILITY_GATE_ROLE_FILE:-$(dirname -- "${BASH_SOURCE[0]}")/../.secrets/mcp-role}"

role="$(head -n 1 "$ROLE_FILE" 2>/dev/null | tr -d '\r' || true)"
case "$role" in
    publisher) login_key='WP_PUBLISHER_USER'; login_default='agent-publisher' ;;
    reader)    login_key='WP_READER_USER';    login_default='agent-reader' ;;
    *)         role='admin'; login_key='WP_ADMIN_USER'; login_default='admin' ;;
esac

# Name the action and the account it runs as. The namespace is the plugin's
# vendor prefix, not a person, so it stays out of the prompt.
reason() {
    local ability="${1:-unknown ability}" user
    user="$(grep -E "^${login_key}=" "$ENV_FILE" 2>/dev/null | tail -n 1 | tr -d '\r' || true)"
    user="${user#*=}"
    user="${user:-$login_default}"
    if [[ "$role" == 'reader' ]]; then
        printf 'WordPress write: %s, as %s. Denied: this client is connected with the read-only reader role.' \
            "${ability#*/}" "$user"
    else
        printf 'WordPress write: %s, as %s. Approve only if this matches what you asked for.' \
            "${ability#*/}" "$user"
    fi
}

# The reader role's WordPress capabilities still allow drafts (the read
# abilities need edit_posts), so its writes are denied here, not asked.
decision='ask'
[[ "$role" != 'reader' ]] || decision='deny'

mode="${1:-}"

# Without jq the gate can neither read the payload nor answer "ask". Exit 2
# is the one code both clients treat as a block; any other failure lets the
# call through in Claude Code.
if [[ "$mode" == 'claude' || "$mode" == 'cursor' ]] && ! command -v jq >/dev/null 2>&1; then
    printf 'ability-gate: jq is not installed, so WordPress ability calls are blocked. See docs/development.md.\n' >&2
    exit 2
fi

case "$mode" in
    classify)
        classify "${2:-}"
        printf '\n'
        ;;

    claude)
        payload="$(cat)"
        tool="$(hook_field '.tool_name')"
        if [[ -n "$tool" && "$tool" != *mcp-adapter-execute-ability ]]; then
            exit 0
        fi
        ability=''
        [[ -z "$tool" ]] || ability="$(hook_field '.tool_input.ability_name')"
        [[ "$(classify "$ability")" == 'read' ]] && exit 0
        jq -n --arg reason "$(reason "$ability")" --arg decision "$decision" '{
            hookSpecificOutput: {
                hookEventName: "PreToolUse",
                permissionDecision: $decision,
                permissionDecisionReason: $reason
            }
        }'
        ;;

    cursor)
        payload="$(cat)"
        tool="$(hook_field '.tool_name')"
        if [[ -n "$tool" && "$tool" != *mcp-adapter-execute-ability ]]; then
            printf '{"permission":"allow"}\n'
            exit 0
        fi
        # Cursor passes tool_input as a JSON string.
        ability=''
        [[ -z "$tool" ]] || ability="$(hook_field '.tool_input | (fromjson? // .) | .ability_name?')"
        if [[ "$(classify "$ability")" == 'read' ]]; then
            printf '{"permission":"allow"}\n'
        else
            jq -n --arg reason "$(reason "$ability")" --arg decision "$decision" \
                '{permission: $decision, user_message: $reason, agent_message: $reason}'
        fi
        ;;

    *)
        printf 'usage: ability-gate claude | cursor | classify <ability>\n' >&2
        exit 64
        ;;
esac
