#!/usr/bin/env bash
#
# setup — validate prerequisites, create .env, build and start the stack,
#         install and configure WordPress, and issue the Application Password
#         Claude Code authenticates with.
#
# Safe to run repeatedly: nothing here destroys existing development content.
# To start from nothing, use ./bin/reset.

source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

# ---------------------------------------------------------------------------
step 'Checking prerequisites'
# ---------------------------------------------------------------------------
require_docker
ok "docker $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo '?')"
ok "docker compose $(docker compose version --short 2>/dev/null || echo '?')"

have git || die 'git is not installed or not on PATH.'
ok "git $(git --version | awk '{print $3}')"

if have claude; then
    ok "claude code $(claude --version 2>/dev/null | awk '{print $1}')"
else
    warn 'claude is not on PATH. Everything else will work; ./bin/connect will not.'
fi

have curl || die 'curl is not installed or not on PATH.'

# ---------------------------------------------------------------------------
step 'Environment file'
# ---------------------------------------------------------------------------
random_secret() {
    if have openssl; then
        openssl rand -base64 32 | tr -d '\n=+/' | cut -c1-32
    else
        LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32
    fi
}

if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    info 'Created .env from .env.example'
else
    info '.env already present; leaving your values alone'
fi

if grep -qE '^[A-Z_]+=CHANGE_ME[[:space:]]*$' "$ENV_FILE"; then
    tmp="$ENV_FILE.tmp.$$"
    : > "$tmp"
    filled=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^([A-Z_]+)=CHANGE_ME[[:space:]]*$ ]]; then
            printf '%s=%s\n' "${BASH_REMATCH[1]}" "$(random_secret)" >> "$tmp"
            filled+=("${BASH_REMATCH[1]}")
        else
            printf '%s\n' "$line" >> "$tmp"
        fi
    done < "$ENV_FILE"
    mv "$tmp" "$ENV_FILE"
    ok "Generated random values for: ${filled[*]}"
else
    note 'No CHANGE_ME placeholders left to fill'
fi

require_env
secure_chmod 600 "$ENV_FILE"

WP_PORT="$(env_get WP_PORT 8080)"
DB_PORT="$(env_get DB_PORT 3307)"

# ---------------------------------------------------------------------------
step 'Checking host ports'
# ---------------------------------------------------------------------------
port_busy() {
    local port="$1"
    ( exec 3<>"/dev/tcp/127.0.0.1/$port" ) >/dev/null 2>&1
}

check_port() {
    local port="$1" label="$2" var="$3"
    if ! port_busy "$port"; then
        ok "127.0.0.1:$port free ($label)"
        return
    fi
    if container_running "${4}"; then
        ok "127.0.0.1:$port in use by this project's $label container"
        return
    fi
    die "127.0.0.1:$port is already in use by something else ($label).
    Set $var to a free port in .env and re-run ./bin/setup."
}

check_port "$WP_PORT" 'WordPress' WP_PORT wordpress
check_port "$DB_PORT" 'database' DB_PORT db

# ---------------------------------------------------------------------------
step 'Loopback bindings'
# ---------------------------------------------------------------------------
require_loopback_bindings
ok 'Compose ports bind to 127.0.0.1 only'

# ---------------------------------------------------------------------------
step 'Building the WordPress image'
# ---------------------------------------------------------------------------
dc build wordpress

# ---------------------------------------------------------------------------
step 'Starting services'
# ---------------------------------------------------------------------------
dc up -d --wait --wait-timeout 300
ok 'db and wordpress are healthy'

# ---------------------------------------------------------------------------
step 'Provisioning WordPress'
# ---------------------------------------------------------------------------
wpx wp-provision

# ---------------------------------------------------------------------------
step 'Application Password'
# ---------------------------------------------------------------------------
umask 077
mkdir -p "$SECRETS_DIR"
secure_chmod 700 "$SECRETS_DIR"
cat > "$SECRETS_DIR/README.md" <<'EOF'
Local credentials generated by ./bin/setup. This directory is git-ignored and
must stay that way. Delete it and re-run ./bin/setup to rotate the
Application Password.
EOF

wpx wp-app-password available >/dev/null 2>&1 \
    || die 'WordPress refuses Application Password authentication on this site.
    Check that WP_ENVIRONMENT_TYPE is "local" — see docs/troubleshooting.md.'
ok 'WordPress accepts Application Password authentication'

mcp_auth_works() {
    local creds="$1" status
    status="$(http_status "$(mcp_endpoint)" \
        -X POST \
        --user "$creds" \
        -H 'Content-Type: application/json' \
        -H 'Accept: application/json, text/event-stream' \
        -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"bin-setup","version":"1.0.0"}}}')"
    [[ "$status" == '200' ]]
}

reuse=false
if creds="$(mcp_basic_auth 2>/dev/null)" \
    && wpx wp-app-password exists >/dev/null 2>&1 \
    && mcp_auth_works "$creds"; then
    reuse=true
fi

if [[ "$reuse" == true ]]; then
    secure_chmod 600 "$APP_PASSWORD_FILE"
    ok "Reusing the existing Application Password in ${APP_PASSWORD_FILE#"$REPO_ROOT/"}"
else
    umask 077
    wpx wp-app-password create | tr -d '\r\n' > "$APP_PASSWORD_FILE"
    [[ -s "$APP_PASSWORD_FILE" ]] || die 'WordPress returned an empty Application Password.'
    secure_chmod 600 "$APP_PASSWORD_FILE"
    ok "Created a new Application Password in ${APP_PASSWORD_FILE#"$REPO_ROOT/"}"

    creds="$(mcp_basic_auth)"
    mcp_auth_works "$creds" \
        || die "The MCP endpoint rejected the new Application Password.
    Try: ./bin/status, then docs/troubleshooting.md."
fi
ok 'MCP endpoint authenticated an initialize request'

# ---------------------------------------------------------------------------
printf '\n%sSetup complete.%s\n\n' "$C_GREEN$C_BOLD" "$C_RESET"
printf '  WordPress      %s\n' "$(site_url)"
printf '  wp-admin       %s/wp-admin/  (%s)\n' "$(site_url)" "$(env_get WP_ADMIN_USER admin)"
printf '  MCP endpoint   %s\n' "$(mcp_endpoint)"
printf '\n  Next:  ./bin/connect    register the MCP server with Claude Code\n'
printf '         ./bin/test       run the full test suite\n\n'
