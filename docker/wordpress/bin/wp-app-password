#!/bin/bash
# Manage the WordPress Application Password that Claude Code authenticates with.
#
# Run inside the WordPress container by ./bin/setup and ./bin/connect:
#   docker compose exec -T wordpress wp-app-password <exists|create|delete|available>
#
# WordPress shows an Application Password exactly once, at creation. `create`
# therefore revokes any password already carrying this label and prints the new
# one on stdout and nothing else, so the host can capture it.
set -euo pipefail

USER_LOGIN="${WP_ADMIN_USER:-admin}"
APP_NAME="${MCP_APP_PASSWORD_NAME:-claude-code-mcp}"

usage() {
    cat >&2 <<'EOF'
Usage: wp-app-password <command>

  available  Exit 0 if WordPress will accept Application Password auth here.
  exists     Exit 0 if an Application Password with this label exists.
  create     Revoke any password with this label, create a new one, print it.
  delete     Revoke every Application Password with this label.
EOF
    exit 64
}

app_ids() {
    wp user application-password list "$USER_LOGIN" \
        --name="$APP_NAME" --field=uuid 2>/dev/null || true
}

case "${1:-}" in
    available)
        # Application Passwords are refused over plain HTTP unless WordPress
        # considers the site local. wp-config.php sets WP_ENVIRONMENT_TYPE=local
        # for exactly this reason — see docs/security.md.
        wp eval 'echo wp_is_application_passwords_available() ? "yes" : "no";' \
            | grep -q '^yes$'
        ;;
    exists)
        [ -n "$(app_ids)" ]
        ;;
    delete)
        for uuid in $(app_ids); do
            wp user application-password delete "$USER_LOGIN" "$uuid" >/dev/null
        done
        ;;
    create)
        for uuid in $(app_ids); do
            wp user application-password delete "$USER_LOGIN" "$uuid" >/dev/null
        done
        wp user application-password create "$USER_LOGIN" "$APP_NAME" --porcelain
        ;;
    *)
        usage
        ;;
esac
